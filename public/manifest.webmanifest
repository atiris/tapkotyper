{
  "id": "./",
  "name": "TapkoTyper",
  "short_name": "TapkoTyper",
  "description": "A peaceful story-driven touch-typing adventure for children.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#e9f8ef",
  "theme_color": "#7cc79a",
  "lang": "sk",
  "related_applications": [
    { "platform": "webapp", "url": "https://atiris.github.io/tapkotyper/manifest.webmanifest", "id": "https://atiris.github.io/tapkotyper/" }
  ],
  "protocol_handlers": [
    { "protocol": "web+tapkotyper", "url": "./?open=%s" }
  ],
  "file_handlers": [
    { "action": "./#/teacher/files", "accept": { "application/x-tapkotyper": [".tapko"] } }
  ],
  "icons": [
    { "src": "icons/tapko-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/tapko-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/tapko-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
